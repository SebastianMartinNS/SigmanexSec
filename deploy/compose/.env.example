# deploy/compose/.env.example — copy to .env and edit before bringing up
# the stack with ``docker compose -f deploy/compose/docker-compose.yml up``.
#
# Every variable is optional; defaults are picked to match the v2.3
# single-agent legacy behaviour. Flip the SAP_V3_* flags only when you
# are ready to opt into the new capabilities (see
# docs/migration_v2.3_to_v3.0.md).

# ── Image version (mirrors the GitHub release tag) ──────────────────────
SAP_VERSION=v3.0.0

# ── LLM provider ────────────────────────────────────────────────────────
# anthropic | openai | local (OpenAI-compatible: llama.cpp, LM Studio, ...)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Used only when LLM_PROVIDER=openai
OPENAI_API_KEY=
# Used only when LLM_PROVIDER=local
LOCAL_BASE_URL=http://host.docker.internal:8080/v1
LOCAL_LLM_API_KEY=local

# Default model. Override with provider-specific id.
LLM_MODEL=claude-opus-4-7

# ── At-rest encryption (Argon2id + Fernet) ──────────────────────────────
# REQUIRED in production. The same passphrase protects stored
# credentials AND the v3 audit Fernet wrap (unless SAP_AUDIT_FERNET_KEY
# is set to override).
CREDENTIAL_ENCRYPTION_PASSPHRASE=

# ── v3.0 cognitive tracking ─────────────────────────────────────────────
# Default OFF for v3.0.0; flip to 1 when you want compliance-grade audit.
SAP_V3_TRACKING_V2=0
SAP_AUDIT_ENCRYPT=1
SAP_METRICS_ENABLED=1

# ── v3.0 multi-agent ────────────────────────────────────────────────────
# single | multi — default single in v3.0.0, multi from v3.1 onward.
SAP_AGENT_MODE=single
SAP_REFLECTION_MODE=off

# ── Observability (optional) ────────────────────────────────────────────
# When set, every service exports OTLP traces to this endpoint. Leave
# empty to skip tracing entirely (the tracer is a no-op).
SAP_OTEL_ENDPOINT=
SAP_OTEL_SERVICE_NAME=sap-pentest

# ── Runtime tuning ──────────────────────────────────────────────────────
SAP_LLM_REQUEST_TIMEOUT=600
SAP_PROMPT_TOKEN_BUDGET=120000
SAP_TOOL_LOOP_LIMIT=3
SAP_SANDBOX=warn
