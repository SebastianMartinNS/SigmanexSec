diff --git a/tools/server/server-cors-proxy.h b/tools/server/server-cors-proxy.h
index bca50b5..abc3832 100644
--- a/tools/server/server-cors-proxy.h
+++ b/tools/server/server-cors-proxy.h
@@ -30,12 +30,43 @@ static server_http_res_ptr proxy_request(const server_http_req & req, std::strin
         throw std::runtime_error("unsupported URL scheme in target URL: " + parsed_url.scheme);
     }
 
+    // The bundled cpp-httplib in this build is compiled WITHOUT
+    // CPPHTTPLIB_OPENSSL_SUPPORT, so any HTTPS target raises a 500 internal
+    // error. The WebUI fires HTTPS requests at startup (e.g. Google favicon
+    // service) which would flood the log and pollute the JS console with
+    // network errors. Short-circuit them with a graceful 204 No Content so
+    // the UI silently treats them as "no asset available" and moves on.
+#ifndef CPPHTTPLIB_OPENSSL_SUPPORT
+    if (parsed_url.scheme == "https") {
+        SRV_INF("cors-proxy: HTTPS not supported in this build (no OpenSSL); replying 204 for %s\n", target_url.c_str());
+        auto res = std::make_unique<server_http_res>();
+        res->status = 204;
+        res->content_type = "text/plain";
+        res->data = "";
+        return res;
+    }
+#endif
+
     SRV_INF("proxying %s request to %s://%s%s\n", method.c_str(), parsed_url.scheme.c_str(), parsed_url.host.c_str(), parsed_url.path.c_str());
 
+    // Split "host:port" if a port was explicitly specified in the target URL
+    std::string host = parsed_url.host;
+    int port = parsed_url.scheme == "http" ? 80 : 443;
+    auto colon_pos = host.rfind(':');
+    auto bracket_pos = host.rfind(']'); // skip IPv6 "[::1]"
+    if (colon_pos != std::string::npos && (bracket_pos == std::string::npos || colon_pos > bracket_pos)) {
+        try {
+            port = std::stoi(host.substr(colon_pos + 1));
+            host = host.substr(0, colon_pos);
+        } catch (...) {
+            // leave defaults
+        }
+    }
+
     auto proxy = std::make_unique<server_http_proxy>(
             method,
-            parsed_url.host,
-            parsed_url.scheme == "http" ? 80 : 443,
+            host,
+            port,
             parsed_url.path,
             req.headers,
             req.body,
