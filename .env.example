# -----------------------------------------------------------
# Security Assessment Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# -----------------------------------------------------------

# ─────────────────────────────────────────────────────────────
# LOCAL (default) — llama.cpp server, Ollama, LM Studio, koboldcpp
# All expose an OpenAI-compatible API on /v1
# ─────────────────────────────────────────────────────────────
LLM_PROVIDER=local

# llama.cpp server:  http://localhost:8080/v1
# Ollama:            http://localhost:11434/v1
# LM Studio:         http://localhost:1234/v1
# koboldcpp:         http://localhost:5001/v1
LOCAL_LLM_BASE_URL=http://localhost:8080/v1

# Model name passed to the server.
# llama.cpp:  any string (server ignores it, so use a label you like)
# Ollama:     exact tag, e.g. qwen3:30b-a3b-q4_K_M
# LM Studio:  exact model ID shown in the UI
LLM_MODEL=qwen3-30b-a3b-q4

# API key — local servers usually accept anything; leave as "local"
LOCAL_LLM_API_KEY=local

# Thinking mode for Qwen3:
#   no_think — faster, less tokens, good for agentic loops (default)
#   think    — enables chain-of-thought for harder decisions
LOCAL_THINK_MODE=no_think

# ─────────────────────────────────────────────────────────────
# CLOUD (optional fallback)
# ─────────────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-4-5
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-REPLACE_ME

# ─────────────────────────────────────────────────────────────
# Storage paths (relative to repo root)
# ─────────────────────────────────────────────────────────────
SESSION_DB_PATH=./sessions/assessments.db
AUDIT_LOG_PATH=./logs/audit.jsonl
REPORTS_DIR=./reports/

# ─────────────────────────────────────────────────────────────
# Dashboard authentication (REQUIRED — dashboard refuses to start
# without these and returns HTTP 503 on every API call.)
# ─────────────────────────────────────────────────────────────
# Single-user bootstrap (treated as 'admin' role):
SAP_DASHBOARD_USER=admin
SAP_DASHBOARD_PASS=CHANGE_ME_use_a_long_random_passphrase

# Multi-user RBAC directory. JSON map: {username: {pass, role}}.
# Roles: viewer (read-only) | operator (run engagements, sudo) | admin (all).
# When set, this is merged with the bootstrap user above (which stays admin).
# Example (uncomment and edit):
# SAP_DASHBOARD_USERS={"alice":{"pass":"…","role":"admin"},"bob":{"pass":"…","role":"operator"},"carol":{"pass":"…","role":"viewer"}}

# Session cookie signing key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without this, every restart invalidates all logged-in sessions.
SAP_SESSION_SECRET=REPLACE_WITH_64_RANDOM_BYTES_BASE64

# Session lifetime (seconds). Defaults: 1800 idle / 28800 absolute.
# SAP_SESSION_IDLE=1800
# SAP_SESSION_MAX_AGE=28800

# ─────────────────────────────────────────────────────────────
# Sudo broker (optional — needed only for tools that require root,
# e.g. masscan, nmap SYN scan, certain hardening checks)
# ─────────────────────────────────────────────────────────────
# Path to the UNIX socket the dashboard uses to talk to the broker:
# SUDO_BROKER_SOCKET=./logs/sudo_broker.sock
# Cache TTL for the unlocked password in mlock'd memory (seconds):
# SUDO_BROKER_TTL=900
